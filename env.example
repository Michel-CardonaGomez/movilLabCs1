EXPO_PUBLIC_CATSDOGS_URL=https://TU-APP.azurewebsites.net/catsdogs?code=TU_CODE
EXPO_PUBLIC_MNIST_URL=https://TU-APP.azurewebsites.net/mnist?code=TU_CODE

# MQTT (ESP32-CAM). En Expo solo las variables EXPO_PUBLIC_* llegan a la app.
# IP de la PC con Mosquitto (o del broker real). NO uses localhost: el celular es otro dispositivo.
EXPO_PUBLIC_MQTT_HOST=192.168.1.50
EXPO_PUBLIC_MQTT_PORT=9001
EXPO_PUBLIC_MQTT_DEVICE_ID=esp32cam01
# Opcionales (el broker de pruebas es anónimo)
# EXPO_PUBLIC_MQTT_USER=
# EXPO_PUBLIC_MQTT_PASSWORD=
